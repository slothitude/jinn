{% macro render_constraints(memories, max_blocks=10) %}
### Active Constraints
{% for m in (memories or []) if "constraint" in (m.tags or []) %}
{% if loop.index <= max_blocks %}
- {{ m.summary }}
{% if m.prompt_fragment %}
  {{ m.prompt_fragment }}
{% endif %}
{% endif %}
{% endfor %}
{% endmacro %}
