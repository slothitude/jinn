{# L5: Wiki/knowledge index rendering #}

{% macro render_wiki_index(wiki_index) %}
{% if wiki_index %}
## COMPILED KNOWLEDGE (from Wiki)
{% for category, pages in wiki_index.items() %}
### {{ category }}
{% for page in pages %}
- **{{ page.title }}**: {{ (page.summary or '') | truncate(120, True, '...') }}
{% endfor %}
{% endfor %}
{% endif %}
{% endmacro %}

{% macro render_wiki_pages(wiki_pages) %}
{% if wiki_pages %}
## RELEVANT WIKI PAGES
{% for page in wiki_pages %}
### {{ page.title }} [{{ page.category }}]
{{ page.content[:1000] }}
{% endfor %}
{% endif %}
{% endmacro %}
